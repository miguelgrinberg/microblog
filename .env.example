# Шаблон локальної конфігурації. Скопіюй у .env і заповни реальними
# значеннями -- .env у .gitignore і НІКОЛИ не комітиться.

SECRET_KEY=change-me-to-a-random-value
DATABASE_URL=

MAIL_SERVER=
MAIL_PORT=25
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=

# ЛР№2: зовнішній сервіс перекладу (для продакшн-подібного запуску --
# для локальної розробки/тестів використовується mock_translator.py)
MS_TRANSLATOR_KEY=
TRANSLATOR_API_URL=https://api.cognitive.microsofttranslator.com/translate

ELASTICSEARCH_URL=
REDIS_URL=redis://
